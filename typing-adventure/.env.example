# Redis
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

# Rate limit: header your reverse proxy sets with the client IP (x-real-ip | x-forwarded-for); empty = trust none
TRUST_PROXY_HEADER=

{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "postgres-ro": {
      "command": "npx",
      "args": ["-y", "@toolbox-sdk/server@1.15.0", "--prebuilt", "postgres", "--stdio"],
      "env": {
        "POSTGRES_HOST": "${MCP_PG_HOST:-localhost}",
        "POSTGRES_PORT": "${MCP_PG_PORT:-5432}",
        "POSTGRES_DATABASE": "${MCP_PG_DATABASE:-typing_adventure}",
        "POSTGRES_USER": "${MCP_PG_USER:-mcp_ro}",
        "POSTGRES_PASSWORD": "${MCP_PG_PASSWORD:-mcp_ro}"
      }
    }
  }
}
